PORT=4000
NODE_ENV=development
AI_PROVIDER=local
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173
DB_PATH=./data/medora.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
UPLOAD_DIR=./data/uploads
UPLOAD_TEMP_DIR=./data/temp_uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Free / self-hosted LLM (any OpenAI-compatible server). Leave AI_PROVIDER unset to use the built-in engine only.
# AI_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1     # or http://YOUR-VM:11434/v1 for your own Ollama
# LLM_MODEL=llama-3.1-8b-instant                  # any open model your provider offers
# LLM_API_KEY=
# LLM_VISION=false                                # true only if the model accepts images
